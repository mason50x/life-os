# ── WorkOS AuthKit (dashboard sign-in + MCP OAuth) ──────────────────────────
# From https://dashboard.workos.com → API Keys
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
# 32+ char random string: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=""
# Must match a Redirect URI in the WorkOS dashboard. Production: https://lifeos.you/callback
# If unset, middleware derives https://<request-host>/callback so AuthKit does not throw.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"
# Your AuthKit domain (Authentication → AuthKit → domain), e.g. https://your-app.authkit.app
WORKOS_AUTHKIT_DOMAIN=""

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 32 bytes base64 for token encryption at rest: openssl rand -base64 32
LIFEOS_ENCRYPTION_KEY=""
# Shared secret between Next.js and Convex: openssl rand -hex 32
# Also set it in Convex: npx convex env set LIFEOS_SERVICE_KEY <same value>
LIFEOS_SERVICE_KEY=""

# ── Convex ──────────────────────────────────────────────────────────────────
# Populated by `npx convex dev` on first run
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL=""

# ── Google (Gmail) OAuth app ────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials (Web application)
# Redirect URI: http://localhost:3000/api/connect/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Microsoft (Outlook) OAuth app ───────────────────────────────────────────
# https://entra.microsoft.com → App registrations (multitenant + personal accounts)
# Redirect URI: http://localhost:3000/api/connect/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
