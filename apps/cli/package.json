{
  "name": "@cognify-software/lifeos",
  "version": "0.2.3",
  "description": "Command line for LifeOS — connect every inbox, then give any MCP client one connection to all of them.",
  "keywords": [
    "lifeos",
    "mcp",
    "email",
    "gmail",
    "outlook",
    "icloud",
    "cli"
  ],
  "homepage": "https://github.com/mason50x/life-os#readme",
  "bugs": "https://github.com/mason50x/life-os/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mason50x/life-os.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "lifeos": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "commander": "^13.1.0",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
